# ──────────────────────────────────────────────────────────────
# Bullet Digital Media monorepo .gitignore
# ──────────────────────────────────────────────────────────────

# macOS
.DS_Store

# Local rendered artefacts (HTML/PDF generated from markdown)
output/

# Secrets / env (.env.example is the template, kept in repo)
.env
.env.*
!.env.example

# Node / pnpm / Vite / Next
node_modules/
.pnpm-store/
dist/
.next/
out/
coverage/
*.tsbuildinfo

# Python / uv / pytest / ruff
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
!.vscode/settings.example.json
*.swp
*.swo

# Logs
*.log
logs/

# Claude Code project-local MCP server config (user-managed, not shared)
.mcp.json

# Playwright MCP scratch output (page snapshots, console logs, may contain secrets)
.playwright-mcp/
