              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Inngest Api"
      },
      "put": {
        "operationId": "put_inngest_api_api_inngest_put",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Put Inngest Api"
