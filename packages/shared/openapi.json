{
  "components": {
    "schemas": {
      "AdminPingResponse": {
        "description": "`/admin/ping` payload - the `require_founder` smoke endpoint.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "email"
        ],
        "title": "AdminPingResponse",
        "type": "object"
      },
      "ClientListItem": {
        "description": "One row of the dashboard `/clients` list view (S1-31).\n\n`id` is stringified (opaque identifier, same as `MeResponse`).\n`step_entered_at` is the time the client entered `current_step`; the\ndashboard derives the displayed time-in-step from it client-side so the\nduration ticks without a refetch. `last_action_*` describe the client's\nmost-recently-started `platform_actions` row (the onboarding-health\nsignal); all three are null for a client with no recorded actions yet.",
        "properties": {
          "business_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Name"
          },
          "contact_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Name"
          },
          "current_step": {
            "title": "Current Step",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Action"
          },
          "last_action_platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Action Platform"
          },
          "last_action_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Action Status"
          },
          "step_entered_at": {
            "format": "date-time",
            "title": "Step Entered At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "business_name",
          "contact_name",
          "email",
          "current_step",
          "step_entered_at",
          "last_action_status",
          "last_action_platform",
          "last_action"
        ],
        "title": "ClientListItem",
        "type": "object"
      },
      "ClientsListResponse": {
        "description": "Envelope for `GET /clients` - every client, newest step-change first.",
        "properties": {
          "clients": {
            "items": {
              "$ref": "#/components/schemas/ClientListItem"
            },
            "title": "Clients",
            "type": "array"
          }
        },
        "required": [
          "clients"
        ],
        "title": "ClientsListResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthzResponse": {
        "description": "Liveness probe payload - `{\"status\": \"ok\"}`.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthzResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "description": "Authenticated user profile returned by `/me`.\n\n`id` is serialised as a string (the handler stringifies the UUID) so\nthe generated client treats it as an opaque identifier.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "full_name",
          "role"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "ResendConfirmationRequest": {
        "description": "Body for `POST /auth/resend-confirmation`.\n\nReplaces the previous bare `dict[str, str]` so the email is validated\nand the request schema is precise in the generated client.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ResendConfirmationRequest",
        "type": "object"
      },
      "StatusResponse": {
        "description": "Generic `{\"status\": \"...\"}` envelope.\n\nReused by the auth endpoints (login / logout / confirm /\nresend-confirmation) which all report progress through a single\n`status` string (`ok`, `confirmed`, `already_confirmed`,\n`sent_if_unconfirmed`).",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "description": "`/version` payload - the running API version string.",
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Bullet Digital Media onboarding orchestration API. Phase 1 - sales call to campaign go-live automation.",
    "title": "bullet-api",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/ping": {
      "get": {
        "description": "Smoke endpoint for the `require_founder` dependency. Returns 200\nonly when the caller's session belongs to a `founder`; 403 for any\nother role; 401 with no session cookie.",
        "operationId": "admin_ping_admin_ping_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminPingResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Admin Ping",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/inngest": {
      "get": {
        "operationId": "get_api_inngest_api_inngest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Api Inngest"
      },
      "post": {
        "operationId": "post_inngest_api_api_inngest_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Post Inngest Api"
      },
      "put": {
        "operationId": "put_inngest_api_api_inngest_put",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Put Inngest Api"
      }
    },
    "/auth/confirm/{token}": {
      "post": {
        "description": "Flip `email_confirmed` and stamp `email_confirmed_at` for the user\nencoded in `token`. Idempotent for already-confirmed users.",
        "operationId": "confirm_email_auth_confirm__token__post",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Verify credentials and issue a session cookie.\n\nStatus codes:\n- 200 with `Set-Cookie: session=...`: successful login.\n- 401 `Invalid credentials`: unknown email, or password mismatch.\n- 403 `Email not confirmed...`: credentials valid but\n  `email_confirmed=false` (S1-14 confirmation flow has not completed).\n- 429 `Too many failed login attempts...`: caller IP has accumulated\n  `tracker.max_attempts` failures inside `tracker.window`.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Invalidate the caller's current session.\n\nStatus codes:\n- 200 ``{\"status\": \"ok\"}``: session deleted and cookie cleared.\n- 401: no session cookie present, or the session has already expired.\n\n``_user`` being resolved by ``get_current_user`` guarantees the session\nis valid before we touch the DB. ``session_token`` carries the same raw\nvalue ``get_current_user`` read; FastAPI resolves both independently from\nthe same cookie header.",
        "operationId": "logout_auth_logout_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/resend-confirmation": {
      "post": {
        "description": "Re-send the confirmation email for an unconfirmed user.\n\nBody: `{\"email\": \"...\"}` (validated as an email address; a malformed\nor missing value is rejected with 422 by request validation). Always\nreturns 200 with the same status regardless of whether the email\nmatched a real user - this keeps the endpoint from being a free\nuser-enumeration oracle.",
        "operationId": "resend_confirmation_auth_resend_confirmation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resend Confirmation",
        "tags": [
          "auth"
        ]
      }
    },
    "/clients": {
      "get": {
        "description": "List every client for the dashboard board. 401 without a live session.",
        "operationId": "list_clients_clients_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientsListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Clients",
        "tags": [
          "clients"
        ]
      }
    },
    "/healthz": {
      "get": {
        "description": "Liveness probe consumed by Render's health check.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthzResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "meta"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Return the authenticated user's profile. 401 if no live session.\n\nUsed by the dashboard on bootstrap to populate the header and decide\nwhich role-gated routes to render.",
        "operationId": "me_me_get",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/version": {
      "get": {
        "description": "Return the current API version. Used by deploy verification + the\ndashboard's build-info widget.",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
