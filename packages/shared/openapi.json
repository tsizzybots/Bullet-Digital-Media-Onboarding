    "/auth/confirm/{token}": {
      "post": {
        "description": "Flip `email_confirmed` and stamp `email_confirmed_at` for the user\nencoded in `token`. Idempotent for already-confirmed users.",
        "operationId": "confirm_email_auth_confirm__token__post",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "title": "Token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "Verify credentials and issue a session cookie.\n\nStatus codes:\n- 200 with `Set-Cookie: session=...`: successful login.\n- 401 `Invalid credentials`: unknown email, or password mismatch.\n- 403 `Email not confirmed...`: credentials valid but\n  `email_confirmed=false` (S1-14 confirmation flow has not completed).\n- 429 `Too many failed login attempts...`: caller IP has accumulated\n  `tracker.max_attempts` failures inside `tracker.window`.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Invalidate the caller's current session.\n\nStatus codes:\n- 200 ``{\"status\": \"ok\"}``: session deleted and cookie cleared.\n- 401: no session cookie present, or the session has already expired.\n\n``_user`` being resolved by ``get_current_user`` guarantees the session\nis valid before we touch the DB. ``session_token`` carries the same raw\nvalue ``get_current_user`` read; FastAPI resolves both independently from\nthe same cookie header.",
        "operationId": "logout_auth_logout_post",
        "parameters": [
          {
            "in": "cookie",
            "name": "session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/resend-confirmation": {
      "post": {
        "description": "Re-send the confirmation email for an unconfirmed user.\n\nBody: `{\"email\": \"...\"}` (validated as an email address; a malformed\nor missing value is rejected with 422 by request validation). Always\nreturns 200 with the same status regardless of whether the email\nmatched a real user - this keeps the endpoint from being a free\nuser-enumeration oracle.",
        "operationId": "resend_confirmation_auth_resend_confirmation_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendConfirmationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resend Confirmation",
        "tags": [
          "auth"
        ]
      }
    },
