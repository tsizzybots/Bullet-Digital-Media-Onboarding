# Copy this file to .env and fill in values for local development.
# .env is gitignored; never commit secrets to the repo.
#
# Phase 1 environment variables will be added here as they are introduced
# (see docs/PRD.md section 11.6 and Sprint 1 task S1-21).

# ──────────────────────────────────────────────────────────────────────────
# S1-02: Local docker compose stack (Postgres 16 + pgvector, Inngest dev)
# Defaults match docker-compose.yml so a fresh `cp .env.example .env` works
# end-to-end against the local stack with no edits.
# ──────────────────────────────────────────────────────────────────────────

POSTGRES_USER=bullet
POSTGRES_PASSWORD=bullet
POSTGRES_DB=bullet_dev
POSTGRES_PORT=5432

# Used by apps/api (SQLAlchemy + Alembic via S1-05) and scripts/verify_pgvector.py.
# Keep the canonical `postgresql://` scheme here so psql, psycopg, and the Neon
# CLI all accept it. The async session and Alembic env.py rewrite this to
# `postgresql+asyncpg://` internally.
DATABASE_URL=postgresql://bullet:bullet@localhost:5432/bullet_dev

# S1-05a: asyncpg ssl mode applied via connect_args on the SQLAlchemy engine.
# 'prefer' works for both local docker Postgres (TLS absent -> falls back to
# plain) and Neon (TLS mandatory -> auto-upgraded). Render env groups for
# staging / prod override this to 'require' (or stricter) so a mis-configured
# local .env cannot disable TLS in those environments.
DATABASE_SSL_MODE=prefer

# Inngest dev server UI + event API (started by docker compose).
INNGEST_DEV_PORT=8288
INNGEST_DEV_SERVER_URL=http://localhost:8288

# ──────────────────────────────────────────────────────────────────────────
# S1-17: dashboard <-> API wiring
# ──────────────────────────────────────────────────────────────────────────

# Base URL the dashboard's typed API client calls (no trailing slash).
# NEXT_PUBLIC_ is inlined into the browser bundle by Next at build time.
# Local default points at the API dev server (`make api-dev`); Render env
# groups set this to the deployed API host per environment.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins the API allows for credentialed CORS
# (the dashboard). Read by apps/api Settings.cors_allow_origins. Credentialed
# CORS forbids the `*` wildcard, so origins must be listed explicitly.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# S1-20: Sentry error monitoring
# ──────────────────────────────────────────────────────────────────────────

# API (apps/api) DSN. Empty -> Sentry disabled locally; errors stay in the
# console. Render staging / prod env wire a real per-service DSN.
SENTRY_DSN=

# Environment tag attached to every event. Render env groups override this
# to 'staging' / 'production' per environment.
SENTRY_ENVIRONMENT=local

# Dashboard (apps/dashboard) browser DSN. NEXT_PUBLIC_ is inlined into the
# client bundle at build time. Empty -> Sentry disabled in the browser.
NEXT_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are Render build-time only
# (used by the dashboard's Sentry plugin to upload source maps during the
# production build). They are NOT needed for local dev and are intentionally
# omitted here.

# ──────────────────────────────────────────────────────────────────────────
# S1-22: PandaDoc webhook receiver
# ──────────────────────────────────────────────────────────────────────────

# Shared key used to verify PandaDoc webhook HMAC-SHA256 signatures on
# POST /webhooks/pandadoc. Empty locally (the handler rejects all requests
# with 401 when unset). Render staging / prod env groups set the real value
# (the "Shared Key" configured on the PandaDoc webhook subscription).
PANDADOC_WEBHOOK_SECRET=
